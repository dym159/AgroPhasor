# ==============================================================================
# AgroPhasor · Variables de Entorno de Ejemplo (.env.example)
# Reto: NASA Space Apps Challenge 2026 - Field Shift: Adapting Farms with NASA Data
# Copia este archivo como '.env' para desarrollo local:
#   cp .env.example .env
# NUNCA subas tu archivo '.env' real al repositorio.
# ==============================================================================

# Configuración del Servidor Backend (FastAPI / Python)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# NASA POWER API (100% pública, no requiere API Key)
# Documentación: https://power.larc.nasa.gov/docs/services/api/temporal/daily/
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_COMMUNITY=AG
NASA_POWER_TIMEOUT_SECONDS=30
NASA_POWER_MAX_RETRIES=3

# Parcela de Demostración por Defecto (Valle del Mantaro, Junín, Perú)
DEMO_PARCEL_NAME="Valle del Mantaro - Lote Base"
DEMO_LATITUDE=-12.06
DEMO_LONGITUDE=-75.21
DEMO_ELEVATION_M=3250

# NASA Earthdata Login (Opcional - Requerido únicamente para SMAP L3/L4 o SRTM crudo)
# Registro gratuito: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=ejemplo_usuario_earthdata
EARTHDATA_PASSWORD=ejemplo_password_earthdata

# Google Cloud Platform (Para despliegue en Cloud Run - configurar en CI/CD secrets)
GCP_PROJECT_ID=agrophasor-spaceapps
GCP_REGION=us-central1
