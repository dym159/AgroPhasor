# ==============================================================================
# AgroPhasor · Example Environment Variables (.env.example)
# Challenge: NASA Space Apps Challenge 2026 - Field Shift: Adapting Farms with NASA Data
# Copy this file to '.env' for local development:
#   cp .env.example .env
# NEVER commit your actual '.env' file to the repository.
# ==============================================================================

# Backend Server Configuration (FastAPI / Python)
PORT=5173
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# NASA POWER API (100% public, no API Key required)
# Documentation: https://power.larc.nasa.gov/docs/services/api/temporal/daily/
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_COMMUNITY=AG
NASA_POWER_TIMEOUT_SECONDS=30
NASA_POWER_MAX_RETRIES=3

# Default Demo Parcel (Mantaro Valley, Junín, Peru)
DEMO_PARCEL_NAME="Mantaro Valley - Baseline Parcel"
DEMO_LATITUDE=-12.06
DEMO_LONGITUDE=-75.21
DEMO_ELEVATION_M=3250

# NASA Earthdata Login (Optional - Only required for raw SMAP L3/L4 or SRTM)
# Free registration: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=example_earthdata_user
EARTHDATA_PASSWORD=example_earthdata_password

# Google Cloud Platform (For Cloud Run deployment - configure in CI/CD secrets)
GCP_PROJECT_ID=agrophasor-spaceapps
GCP_REGION=us-central1
