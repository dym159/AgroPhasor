#!/bin/sh
# ==============================================================================
# Git Pre-Commit Hook — AgroPhasor (Nasa_AgroFarm)
# Based on Quippu security architecture and Linear task CC-01.
# 1. Checks staged sensitive files (.env, GCP credentials, .netrc, private keys).
# 2. Blocks residual merge conflict markers.
# 3. Scans staged files with Gitleaks (--redact).
# 4. Warns when committing directly to the main branch.
# ==============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "🔒 [pre-commit] Starting security checks..."

# ------------------------------------------------------------------------------
# 1. Confidential filename check
# ------------------------------------------------------------------------------
SENSITIVE_FILES=$(git diff --cached --name-only | grep -E '(\.env$|\.env\.|\.netrc$|\.pem$|\.key$|id_rsa|.*gcp.*\.json$|.*credentials.*\.json$|.*service_account.*\.json$|client_secret.*\.json$)' | grep -v '\.env\.example$' || true)

if [ -n "$SENSITIVE_FILES" ]; then
    echo "❌ ERROR [pre-commit]: Sensitive files detected in staging area:"
    echo "$SENSITIVE_FILES"
    echo ""
    echo "(!) For security and CC-01 compliance, never commit .env files, GCP credentials, or private keys."
    echo "    Ensure they are listed in .gitignore."
    echo "    If this is a justified false positive, use: git commit --no-verify"
    exit 1
fi

# ------------------------------------------------------------------------------
# 2. Merge conflict marker check
# ------------------------------------------------------------------------------
MERGE_CONFLICTS=$(git diff --cached --check 2>/dev/null | grep 'conflict marker' || true)

if [ -n "$MERGE_CONFLICTS" ]; then
    echo "❌ ERROR [pre-commit]: Merge conflict markers found (<<<<<<< / ======= / >>>>>>>):"
    echo "$MERGE_CONFLICTS"
    echo "Please resolve all conflicts before continuing."
    exit 1
fi

# ------------------------------------------------------------------------------
# 3. Gitleaks scan on staged files
# ------------------------------------------------------------------------------
if command -v gitleaks >/dev/null 2>&1; then
    echo "🛡️  [pre-commit] Scanning staged files with Gitleaks..."
    gitleaks protect --staged -v --redact
    echo "✓ [pre-commit] No secrets detected by Gitleaks."
elif command -v docker >/dev/null 2>&1; then
    echo "🛡️  [pre-commit] Scanning with Gitleaks (Docker)..."
    docker run --rm -v "$REPO_ROOT:/repo" zricethezav/gitleaks:latest \
        protect --staged --source /repo -v --redact
    echo "✓ [pre-commit] No secrets detected by Gitleaks."
else
    echo "⚠️  [pre-commit] Gitleaks is not in PATH." >&2
    echo "   To protect your secrets, install it with: winget install Gitleaks.Gitleaks" >&2
fi

# ------------------------------------------------------------------------------
# 4. Main branch best-practice warning
# ------------------------------------------------------------------------------
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
    echo "⚠️  WARNING [pre-commit]: You are committing directly to the main branch ('$BRANCH')."
    echo "   Recommendation: Consider creating a feature branch (e.g., git checkout -b feature/my-task)."
fi

echo "✅ [pre-commit] Checks completed successfully."
exit 0
