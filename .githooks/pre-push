#!/bin/sh
# ==============================================================================
# Git Pre-Push Hook — AgroPhasor (Nasa_AgroFarm)
# Based on Quippu architecture.
# Runs local CI validations before allowing 'git push'.
# If Gitleaks or project checks fail, the push is aborted.
# ==============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ -f "$REPO_ROOT/check-ci.sh" ]; then
    exec "$REPO_ROOT/check-ci.sh"
else
    echo "⚠️  [pre-push] check-ci.sh not found in repository root."
    exit 0
fi
