# ==============================================================================
# .gitignore — AgroPhasor (Nasa_AgroFarm)
# Strict compliance with Linear task CC-01 and security standards
# ==============================================================================

# Environment and Secrets (CRITICAL: never commit to Git)
.env
.env.*
.env*.bak*
*.bak*
!.env.example
.netrc

# Google Cloud credentials and private keys
*credentials*.json
client_secret*.json
*gcp*.json
*service_account*.json
*service-account*.json
*.pem
*.key
*.p12
*.jks
id_rsa
id_rsa.pub

# Python (Backend and ODE / Simulation Engine)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Node.js / TypeScript / Frontend (Leaflet, Maps, Dashboard)
node_modules/
.next/
.nuxt/
out/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cached and temporary satellite data
data/cache/
data/raw/
data/temp/
/tmp/rotation-deps/
/tmp/rotation-test-results.txt
*.tmp
*.log

# Editors and IDEs
.vscode/
.idea/
.claude/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
